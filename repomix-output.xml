fn test_les_statistiques_comptent_les_classes() {
    let mut types_un = [false; NB_TYPES];
    types_un[0] = true;
    let exemples = vec![
        Exemple {
            id_joueur: 0,
            entree: vec![0.0; TAILLE_VECTEUR],
