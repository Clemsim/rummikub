    assert!((recompenses[1] + 0.37).abs() < 1e-9);

    // Sans gagnant (profondeur max atteinte) : 0 pour tous
    partie.joueurs[0].main = vec![standard(2, Couleur::Bleu, 3)];
    assert_eq!(recompenses_finales(&partie), vec![0.0, 0.0]);
}
